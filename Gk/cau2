<?php
$prices = [10000,20000,25000,7000,50000];

function calculateTotal($arr) {
    $total = 0;
    foreach ($arr as $price) {
        $total += $price;
    }
    return $total;
}

function findMaxPrice($arr) {
    $maxPrice = $arr[0];
    foreach ($arr as $price) {
        if ($price > $maxPrice) {
            $maxPrice = $price;
        }
    }
    return $maxPrice;
}

echo "Tổng giá trị: " . calculateTotal($prices) . "<br>";
echo "Giá trị lớn nhất: " . findMaxPrice($prices);
?>